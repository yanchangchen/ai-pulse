# AI Pulse Environment Configuration

# Supabase Configuration (Optional - for cloud trend persistence)
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard
# Leave blank to disable Supabase persistence and use local file storage only
SUPABASE_URL=
SUPABASE_KEY=

# Ollama Cloud Configuration
# Get your API key from: https://ollama.com/settings/keys
OLLAMA_API_KEY= ''

# Model to use (must be available on Ollama Cloud)
# Default: qwen3.5:cloud
OLLAMA_MODEL=qwen3.5:cloud

# Ollama Cloud base URL (default is fine for most users)
OLLAMA_BASE_URL=https://api.ollama.com

# Note: Copy this file to .env and fill in your credentials
# Do NOT commit .env to version control (add to .gitignore)
