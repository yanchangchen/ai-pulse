# AI Pulse Environment Configuration

# Supabase Configuration (Optional - for cloud trend persistence)
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard
# Leave blank to disable Supabase persistence and use local file storage only
SUPABASE_URL=
SUPABASE_KEY=

# Qwen Cloud Configuration
# Get your API key from: https://home.qwencloud.com/api-keys
QWEN_API_KEY= ''

# Model to use (must be available on Qwen Cloud)
# Default: qwen3.8-flash
QWEN_MODEL=qwen3.8-flash

# Qwen Cloud Token Plan OpenAI-compatible base URL
QWEN_BASE_URL=https://token-plan.maas.qwencloudapi.com/compatible-mode/v1

# Optional: enable verbose LLM tracing.
# When set to 1/true/yes/on, the LLM client dumps the prompt and raw
# response body to logs/app.log on every empty or failed call.  Useful
# for debugging Qwen Cloud empty-response issues.  Off by default.
LLM_DEBUG=0

# Optional: set to DEBUG to see all log levels (otherwise INFO).
# LOG_LEVEL=INFO

# Note: Copy this file to .env and fill in your credentials
# Do NOT commit .env to version control (add to .gitignore)
